# VITAL backend settings (copy to .env; every value is optional)
PORT=8000
JWT_SECRET_KEY=change-me-in-production-use-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=1440
CORS_ORIGINS=*

# Storage: sqlite (saved to a local file) | memory (lost on restart, handy for tests)
DATABASE_BACKEND=sqlite
SQLITE_DB_PATH=vital.db

# Model weights (default: models/best.pt)
YOLO_MODEL_PATH=models/best.pt

# Optional: also mirror all data to Firebase Firestore (pip install firebase-admin)
FIREBASE_CREDENTIALS_PATH=
FIREBASE_PROJECT_ID=

# Optional: text the patient's contact number on a fall when "SMS notifications" is switched on
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
